{
  "expo": {
    "name": "Reseller Brain OS",
    "slug": "reseller-brain-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "resellerbrain",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.resellerbrain.photointake",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Reseller Brain OS uses your camera to photograph inventory items for AI-powered identification and listing creation.",
        "NSPhotoLibraryUsageDescription": "Reseller Brain OS accesses your photo library to select images of inventory items for AI-powered analysis."
      },
      "minimumOsVersion": "16.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.resellerbrain.photointake",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Reseller Brain OS to access your camera to photograph inventory items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Reseller Brain OS to access your photos to select inventory images."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
